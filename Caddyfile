:80 {
    # Public PoC: synthetic readings and short-lived proposals only. NO executable commands.
    # Leave full /mcp and /agent endpoints protected; stop this Quick Tunnel after testing.
    handle /voice-demo/mcp* {
        uri strip_prefix /voice-demo
        reverse_proxy voice-demo:8002
    }
    handle /mcp* {
        @authorized header Authorization "Bearer {$MCP_TOKEN}"
        route {
            reverse_proxy @authorized mcp:8001
            respond "Unauthorized" 401
        }
    }
    handle {
        reverse_proxy api:8000
    }
}
