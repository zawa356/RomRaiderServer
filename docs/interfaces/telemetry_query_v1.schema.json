{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/romlogger/schemas/telemetry-query-v1.json",
  "title": "RomLogger MCP query_telemetry v1 tool schemas",
  "description": "Top-level validates the query_telemetry tool INPUT. QueryOutput is defined separately in $defs/QueryOutput. Server MUST additionally enforce authorization, per-run anchor validation, unit/definition validation, cursor signature and bounded AST complexity.",
  "$defs": {
    "ParamId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9_.:\\-]+$"
    },
    "Comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op",
        "value"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/ParamId"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte"
          ]
        },
        "value": {
          "type": "number"
        }
      }
    },
    "Between": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op",
        "values"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/ParamId"
        },
        "op": {
          "const": "between"
        },
        "values": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "InList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op",
        "values"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/ParamId"
        },
        "op": {
          "const": "in"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "maxItems": 100
        }
      }
    },
    "IsMissing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/ParamId"
        },
        "op": {
          "const": "is_missing"
        }
      }
    },
    "And": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "and"
      ],
      "properties": {
        "and": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Expression"
          },
          "minItems": 1,
          "maxItems": 20
        }
      }
    },
    "Or": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "or"
      ],
      "properties": {
        "or": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Expression"
          },
          "minItems": 1,
          "maxItems": 20
        }
      }
    },
    "Expression": {
      "oneOf": [
        {
          "$ref": "#/$defs/Comparison"
        },
        {
          "$ref": "#/$defs/Between"
        },
        {
          "$ref": "#/$defs/InList"
        },
        {
          "$ref": "#/$defs/IsMissing"
        },
        {
          "$ref": "#/$defs/And"
        },
        {
          "$ref": "#/$defs/Or"
        },
        {
          "$ref": "#/$defs/IsPresent"
        }
      ]
    },
    "QueryScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drive_session_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 100
        },
        "run_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 100
        },
        "segment_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 100
        },
        "task_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 100
        },
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Select": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_ids"
      ],
      "properties": {
        "parameter_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParamId"
          },
          "minItems": 1,
          "maxItems": 40,
          "uniqueItems": true
        },
        "metadata_fields": {
          "type": "array",
          "items": {
            "enum": [
              "captured_at",
              "record_id",
              "sequence",
              "run_id",
              "segment_id",
              "profile_revision_id",
              "source_kind",
              "quality"
            ]
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "profile_revision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 50,
          "uniqueItems": true
        }
      }
    },
    "Sort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "direction"
      ],
      "properties": {
        "by": {
          "enum": [
            "captured_at",
            "sequence"
          ]
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        }
      }
    },
    "QueryInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicle_id",
        "select"
      ],
      "properties": {
        "vehicle_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/QueryScope"
        },
        "select": {
          "$ref": "#/$defs/Select"
        },
        "where": {
          "$ref": "#/$defs/Expression"
        },
        "source_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "ecu",
              "synthetic"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "default": [
            "ecu"
          ]
        },
        "order": {
          "$ref": "#/$defs/Sort"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "default": 1000
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "anchor": {
          "$ref": "#/$defs/Anchor"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "anchor"
            ]
          },
          "then": {
            "properties": {
              "cursor": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "A request may specify an anchor to seek before/after an arbitrary observation in its run, returning a batch of rows in one call. Use cursor (not anchor) for subsequent pages; anchor and non-null cursor together are invalid. Anchored requests use sequence ascending within the run regardless of time adjustments; supplied order must be sequence/asc or omitted."
    },
    "TelemetryRow": {
      "type": "object",
      "required": [
        "record_id",
        "captured_at",
        "run_id",
        "segment_id",
        "profile_revision_id",
        "source_kind",
        "values",
        "missing_reason"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "format": "uuid"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "segment_id": {
          "type": "string",
          "format": "uuid"
        },
        "profile_revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_kind": {
          "enum": [
            "ecu",
            "synthetic"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "missing_reason": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "not_measured",
              "not_available",
              "invalid",
              "unknown"
            ]
          }
        }
      }
    },
    "QueryOutput": {
      "type": "object",
      "required": [
        "rows",
        "returned",
        "limit",
        "next_cursor",
        "truncated",
        "snapshot_reference",
        "quality"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TelemetryRow"
          }
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "snapshot_reference": {
          "type": "string"
        },
        "quality": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "IsPresent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/ParamId"
        },
        "op": {
          "const": "is_present"
        }
      }
    },
    "Anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "relation"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "format": "uuid"
        },
        "relation": {
          "type": "string",
          "enum": [
            "after",
            "before"
          ]
        }
      },
      "description": "Seek relative to this stored observation's run sequence. The anchor automatically restricts results to that run; it must belong to the authorized vehicle. The anchor is excluded. Use is_present to select actual observations for a parameter."
    }
  },
  "$ref": "#/$defs/QueryInput"
}
