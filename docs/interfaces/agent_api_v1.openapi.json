{
  "openapi": "3.1.0",
  "info": {
    "title": "RomLogger Server–Agent API",
    "version": "1.0.0-draft",
    "description": "Design contract for product v1. This OpenAPI is documentation, NOT proof of an implemented or tested endpoint. Authoritative semantics: docs/interfaces/server_agent_wire_v1.md."
  },
  "servers": [
    {
      "url": "https://{host}",
      "variables": {
        "host": {
          "default": "romlogger.example.invalid"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Telemetry"
    },
    {
      "name": "State"
    },
    {
      "name": "Capabilities"
    },
    {
      "name": "Commands"
    }
  ],
  "components": {
    "securitySchemes": {
      "DeviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque-device-token",
        "description": "Per-device token, TLS required. Bound to device_id and authorized vehicle_id."
      }
    },
    "schemas": {
      "ProfileParameter": {
        "type": "object",
        "required": [
          "parameter_id",
          "name",
          "unit"
        ],
        "properties": {
          "parameter_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "ProfileRevisionRequest": {
        "type": "object",
        "required": [
          "protocol_version",
          "device_id",
          "vehicle_id",
          "profile_revision_id",
          "logger_definition_fingerprint",
          "parameters"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicle_id": {
            "type": "string",
            "format": "uuid"
          },
          "profile_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "logger_definition_fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ProfileParameter"
            }
          }
        }
      },
      "ProfileRevisionResponse": {
        "type": "object",
        "required": [
          "status",
          "profile_revision_id"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "registered",
              "already_registered"
            ]
          },
          "profile_revision_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ObservationValue": {
        "type": "object",
        "required": [
          "parameter_id",
          "value"
        ],
        "properties": {
          "parameter_id": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number",
            "description": "Finite numeric value only. NaN and Infinity are forbidden."
          }
        }
      },
      "ObservationRecord": {
        "type": "object",
        "required": [
          "kind",
          "record_id",
          "segment_id",
          "captured_at",
          "source_kind",
          "sequence",
          "profile_revision_id",
          "values"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "observation"
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "segment_id": {
            "type": "string",
            "format": "uuid"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "ecu",
              "synthetic"
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "profile_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ObservationValue"
            }
          }
        }
      },
      "EventRecord": {
        "type": "object",
        "required": [
          "kind",
          "record_id",
          "segment_id",
          "captured_at",
          "source_kind",
          "event_type",
          "data"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "event"
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "segment_id": {
            "type": "string",
            "format": "uuid"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "ecu",
              "synthetic"
            ]
          },
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "GapRecord": {
        "type": "object",
        "required": [
          "kind",
          "record_id",
          "segment_id",
          "captured_at",
          "source_kind",
          "event_type",
          "data"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "gap"
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "segment_id": {
            "type": "string",
            "format": "uuid"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "ecu",
              "synthetic"
            ]
          },
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Expected gap range and cause; detailed event catalog is implementation-phase schema."
          }
        }
      },
      "TelemetryBatchRequest": {
        "type": "object",
        "required": [
          "protocol_version",
          "batch_id",
          "device_id",
          "vehicle_id",
          "run_id",
          "records"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicle_id": {
            "type": "string",
            "format": "uuid"
          },
          "batch_id": {
            "type": "string",
            "format": "uuid"
          },
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "records": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ObservationRecord"
                },
                {
                  "$ref": "#/components/schemas/EventRecord"
                },
                {
                  "$ref": "#/components/schemas/GapRecord"
                }
              ]
            }
          }
        },
        "description": "All records in a batch belong to the same run. Atomic commit; duplicate records are safe; conflicting records reject the entire batch."
      },
      "TelemetryBatchResponse": {
        "type": "object",
        "required": [
          "status",
          "batch_id",
          "record_count",
          "inserted_count",
          "duplicate_count"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "committed"
          },
          "batch_id": {
            "type": "string",
            "format": "uuid"
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          },
          "inserted_count": {
            "type": "integer",
            "minimum": 0
          },
          "duplicate_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "description": "ACK is valid only after durable DB commit, matching the request batch and record counts."
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "request_id",
          "error"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "AcquisitionStatus": {
        "type": "object",
        "required": [
          "last_observed_at",
          "recent_hz",
          "drop_count"
        ],
        "properties": {
          "last_observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "recent_hz": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "drop_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SpoolStatus": {
        "type": "object",
        "required": [
          "unacked_records",
          "pending_bytes"
        ],
        "properties": {
          "unacked_records": {
            "type": "integer",
            "minimum": 0
          },
          "pending_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "DeviceStatusRequest": {
        "type": "object",
        "required": [
          "protocol_version",
          "device_id",
          "vehicle_id",
          "reported_at",
          "agent_version",
          "logger_state",
          "acquisition",
          "spool"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicle_id": {
            "type": "string",
            "format": "uuid"
          },
          "reported_at": {
            "type": "string",
            "format": "date-time"
          },
          "agent_version": {
            "type": "string",
            "minLength": 1
          },
          "logger_state": {
            "type": "string",
            "enum": [
              "not_started",
              "starting",
              "logging",
              "stopped",
              "error",
              "unknown"
            ]
          },
          "acquisition": {
            "$ref": "#/components/schemas/AcquisitionStatus"
          },
          "spool": {
            "$ref": "#/components/schemas/SpoolStatus"
          },
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "segment_id": {
            "type": "string",
            "format": "uuid"
          },
          "profile_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "ecu_state": {
            "type": "string"
          },
          "link_error_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "DeviceStatusResponse": {
        "type": "object",
        "required": [
          "status",
          "server_received_at"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "recorded"
          },
          "server_received_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ParameterCapability": {
        "type": "object",
        "required": [
          "parameter_id",
          "name",
          "unit",
          "availability"
        ],
        "properties": {
          "parameter_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "availability": {
            "type": "string",
            "enum": [
              "defined",
              "possibly_supported",
              "verified_readable",
              "unsupported",
              "unknown"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      },
      "CapabilitySnapshotRequest": {
        "type": "object",
        "required": [
          "protocol_version",
          "device_id",
          "vehicle_id",
          "logger_version",
          "definition_fingerprint",
          "observed_at",
          "parameters"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicle_id": {
            "type": "string",
            "format": "uuid"
          },
          "logger_version": {
            "type": "string",
            "minLength": 1
          },
          "definition_fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "ecu_identity": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "parameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParameterCapability"
            }
          }
        }
      },
      "StatusResult": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "CommandClaimRequest": {
        "type": "object",
        "required": [
          "protocol_version",
          "device_id",
          "vehicle_id",
          "client_state_revision"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicle_id": {
            "type": "string",
            "format": "uuid"
          },
          "current_plan_revision_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "client_state_revision": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "CommandLease": {
        "type": "object",
        "required": [
          "command_id",
          "action",
          "task_id",
          "plan_revision_id",
          "approval_scope_id",
          "issued_at",
          "expires_at"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "enum": [
              "apply_measurement_plan",
              "suspend_ai_changes",
              "restore_basic_logging"
            ]
          },
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "plan_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "approval_scope_id": {
            "type": "string",
            "format": "uuid"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "expected_profile_revision_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "lease_until": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CommandClaimResponse": {
        "type": "object",
        "required": [
          "status",
          "command"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "none",
              "leased"
            ]
          },
          "command": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CommandLease"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CommandReportRequest": {
        "type": "object",
        "required": [
          "protocol_version",
          "device_id",
          "vehicle_id",
          "command_id",
          "report_id",
          "state",
          "reported_at"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicle_id": {
            "type": "string",
            "format": "uuid"
          },
          "command_id": {
            "type": "string",
            "format": "uuid"
          },
          "report_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "received",
              "rejected",
              "applying",
              "applied_unverified",
              "verified",
              "failed",
              "expired",
              "cancelled",
              "unknown"
            ]
          },
          "observed_profile_revision_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "result_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reported_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReconcileRequest": {
        "type": "object",
        "required": [
          "protocol_version",
          "device_id",
          "vehicle_id",
          "reported_at",
          "client_state_revision"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "vehicle_id": {
            "type": "string",
            "format": "uuid"
          },
          "reported_at": {
            "type": "string",
            "format": "date-time"
          },
          "client_state_revision": {
            "type": "string",
            "minLength": 1
          },
          "current_run_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_profile_revision_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_command_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "local_execution_records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "ReconcileResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "aligned",
              "action_required",
              "unknown"
            ]
          },
          "server_expected_plan_revision_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/agent/v1/profile-revisions/{profile_revision_id}": {
      "parameters": [
        {
          "name": "profile_revision_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "tags": [
          "Telemetry"
        ],
        "summary": "Register immutable profile definition",
        "operationId": "putProfileRevision",
        "security": [
          {
            "DeviceBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileRevisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileRevisionResponse"
                }
              }
            }
          },
          "201": {
            "description": "New immutable definition registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileRevisionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid device credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Device not permitted for the target vehicle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Identifier conflict or stale state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Semantically invalid input or missing profile revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "426": {
            "description": "Unsupported protocol major version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/v1/telemetry/batches": {
      "post": {
        "tags": [
          "Telemetry"
        ],
        "summary": "Atomically commit all telemetry records or none",
        "operationId": "postTelemetryBatch",
        "security": [
          {
            "DeviceBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
